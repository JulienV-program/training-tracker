{
    "name": "C# VSCodium Dev Env",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "muhammad-sammy.csharp" // Extension C# compatible VSCodium
            ]
        }
    },
    "remoteUser": "vscode",
    // Les secrets ne sont jamais écrits ici : ils sont relayés depuis l'environnement de la machine hôte.
    // Définir Strava__ClientId / Strava__ClientSecret / Strava__RefreshToken sur l'hôte avant d'ouvrir le conteneur.
    "containerEnv": {
        "Strava__ClientId": "${localEnv:Strava__ClientId}",
        "Strava__ClientSecret": "${localEnv:Strava__ClientSecret}",
        "Strava__RefreshToken": "${localEnv:Strava__RefreshToken}"
    }
}
