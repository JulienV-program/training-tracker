{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Web (Blazor Server)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/MyTracker.Web/bin/Debug/net8.0/MyTracker.Web.dll",
            "cwd": "${workspaceFolder}/MyTracker.Web",
            "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "http://localhost:5215"
            },
            "stopAtEntry": false
        },
        {
            "name": "Console (export CSV)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/MyTracker.App/bin/Debug/net8.0/MyTracker.App.dll",
            "cwd": "${workspaceFolder}/MyTracker.App",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
