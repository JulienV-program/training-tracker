{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/trainingtracker.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": ["test", "${workspaceFolder}/trainingtracker.sln"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "watch web",
            "command": "dotnet",
            "type": "process",
            "args": ["watch", "run", "--project", "${workspaceFolder}/MyTracker.Web/MyTracker.Web.csproj"],
            "problemMatcher": "$msCompile",
            "isBackground": true
        }
    ]
}
